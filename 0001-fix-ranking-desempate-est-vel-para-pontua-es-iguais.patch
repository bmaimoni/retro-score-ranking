+
+    Mesmo desempate de listar_ranking (criado_em ASC, id ASC) para evitar
+    ordem instável entre pontuações empatadas.
     """
     rows = await pool.fetch(
         """
@@ -215,7 +225,7 @@ async def listar_ranking_por_evento(
           AND superado   = false
           AND pendente   = false
           AND arquivado  = false
-        ORDER BY pontuacao DESC
